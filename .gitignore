# Go
*.test
*.out
/bin/

# Secrets & sessions — NEVER commit (laws: README "Laws", SESSION-PROTOCOL,
# doc 11 §2). Session files and credentials live outside the repo.
*.session
*.session-journal
*.session-shm
*.session-wal
session.json
tg-session*.json
.env
.env.*

# Owner data (config.json / cache.db are opened in place, never committed)
config.json
cache.db
cache.db-wal
cache.db-shm
app.lock

# Python (the differential reference clone stays outside; guards only)
__pycache__/
*.pyc
.venv/
venv/

# Differential harness run artifacts (regenerated per run, evidence is
# copied into docs/ or the session report when needed)
testdiff/runs/

# Wails PoC build outputs
poc/wails/build/

# Release-ritual outputs (build/release.sh writes exes + the zip here;
# the sha256 evidence lives in docs/ — binaries never enter git)
/reports/
